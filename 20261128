void setDriving(bool enabled) {
  if (enabled == driving) return;
  for (const Motor &motor : MOTORS) {
    const uint8_t forwardPin = motor.reversed ? motor.in2 : motor.in1;
    analogWrite(forwardPin, enabled ? FORWARD_PWM : 0);
  }
  driving = enabled;
}

uint16_t readU16(const uint8_t *bytes) {
  return uint16_t(bytes[0]) | (uint16_t(bytes[1]) << 8);
}

uint8_t packetCrc() {
  uint8_t crc = 0;
  for (int i = 0; i < PACKET_BYTES - 1; ++i) {
    crc ^= packet[i];
    for (int bit = 0; bit < 8; ++bit) {
      crc = (crc & 0x80) ? uint8_t((crc << 1) ^ 0x4D) : uint8_t(crc << 1);
    }
  }
  return crc;
}

